{
  "name": "little-adventures",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/node": "^26.4.1",
      "varlock": "1.23.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @little-adventures/db --",
    "db:migrate": "turbo run db:migrate -F @little-adventures/db --",
    "db:push": "turbo run db:push -F @little-adventures/db --",
    "db:studio": "turbo run db:studio -F @little-adventures/db --",
    "dev": "turbo run dev",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "prepare": "husky"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@little-adventures/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.1.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
