# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# The app server (sign-in, profiles). Defaults to production so a fresh clone runs with no .env.
# @public @type=url
EXPO_PUBLIC_SERVER_URL=https://www.littleadventures.app

# The private engine that makes the adventures, e.g. https://engine.littleadventures.app.
# Unset: the app plays its bundled adventure.
# @public @required=false @type=url
EXPO_PUBLIC_ENGINE_URL=
