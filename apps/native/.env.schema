# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# The app server (sign-in, profiles). Defaults to production so a fresh clone runs with no .env.
# @public @type=url
EXPO_PUBLIC_SERVER_URL=https://www.littleadventures.app

# The private engine that makes the adventures. Defaults to production so a fresh clone shows the
# real adventures. To play the bundled sample adventure instead, put EXPO_PUBLIC_ENGINE_URL=""
# (quoted; a bare empty value keeps this default) in .env.
# @public @required=false @type=url
EXPO_PUBLIC_ENGINE_URL=https://engine.littleadventures.app
