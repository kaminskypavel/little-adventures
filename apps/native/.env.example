# Not needed to run the app: with no .env it uses production. Copy to
# apps/native/.env only to use your own server or the bundled sample.
# The typed source of truth is .env.schema.

# The app server (apps/web). Unset: the production app server, so a fresh clone runs
# with no .env. Your own: bun run dev:web serves it on port 3001.
# EXPO_PUBLIC_SERVER_URL=http://localhost:3001

# The Kodio engine's player API. Unset: the production engine. The quoted empty
# value below plays the bundled sample adventure with no engine and no keys
# (a bare EXPO_PUBLIC_ENGINE_URL= counts as unset).
EXPO_PUBLIC_ENGINE_URL=""
