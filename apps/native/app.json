{
  "expo": {
    "name": "little-adventures",
    "slug": "little-adventures",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "little-adventures",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.littleadventures",
      "icon": {
        "dark": "./assets/images/icon-ios-dark.png",
        "light": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-ios-tinted.png"
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Little Adventures looks for your TV on your home network, so a story can play on the big screen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1736",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.littleadventures"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/images/splash-android.png",
            "imageWidth": 150
          },
          "backgroundColor": "#0A1B34",
          "dark": {
            "backgroundColor": "#0A1B34"
          },
          "image": "./assets/images/splash-ios.png",
          "imageWidth": 322,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Little Adventures uses your photo only to draw your child as the storybook hero.",
          "cameraPermission": "Little Adventures uses your photo only to draw your child as the storybook hero.",
          "microphonePermission": "Little Adventures listens only while your child says a question."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Little Adventures listens only while your child says a question."
        }
      ],
      "expo-asset",
      [
        "react-native-google-cast",
        {
          "receiverAppId": "CC1AD845"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
