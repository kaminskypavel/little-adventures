# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Neon Auth (hosted Better Auth). Auth URL from the Neon console. Not secret:
# it reaches the browser in sign-in redirects.
# @sensitive=false @type=url
NEON_AUTH_BASE_URL=
# Signs the session cookie. openssl rand -base64 32
# @type=string(minLength=32)
NEON_AUTH_COOKIE_SECRET=
# URL scheme of the phone app. /auth/native/callback redirects the system
# browser to <scheme>://auth/callback after a social sign-in. Not secret.
# @sensitive=false
NATIVE_APP_SCHEME=little-adventures
# @type=string(minLength=1)
DATABASE_URL=
# R2 storage. All four of ACCOUNT_ID, BUCKET, ACCESS_KEY_ID and
# SECRET_ACCESS_KEY, or none. Only the secret is sensitive: the others appear
# inside presigned urls.
# @required=false @sensitive=false
R2_ACCOUNT_ID=
# @required=false @sensitive=false
R2_BUCKET=
# @required=false @sensitive=false
R2_ACCESS_KEY_ID=
# @required=false
R2_SECRET_ACCESS_KEY=
# Public read host. Unset keeps the bucket private and reads are presigned.
# @required=false @sensitive=false @type=url
R2_PUBLIC_URL=
