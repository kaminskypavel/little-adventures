# Copy to apps/web/.env and fill in. The typed source of truth is .env.schema
# (Varlock checks every value on start). Never commit real values.

# Postgres (Neon) connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Meta Model API key: SAM 3.1 and Muse Image draw the child's looks,
# Muse Voice Transcribe hears the spoken question. Unset: no art, no voice.
META_API_KEY=

# Sign-in (Neon Auth). Base URL from the Neon console; the secret signs the
# session cookie (openssl rand -base64 32).
NEON_AUTH_BASE_URL=https://your-project.neonauth.example/auth
NEON_AUTH_COOKIE_SECRET=
NATIVE_APP_SCHEME=little-adventures

# Private beta: comma separated emails allowed to make art and voice calls.
# Empty lets nobody in.
BETA_EMAILS=

# Optional. Password of the shared guest account ("Try as a guest"). Unset: off.
GUEST_PASSWORD=

# Optional photo storage (S3-compatible). All four or none.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
